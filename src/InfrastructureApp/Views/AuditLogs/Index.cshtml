@model IReadOnlyList<InfrastructureApp.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <h1 class="mb-1"><i class="fa-solid fa-clipboard-list me-2 text-warning"></i>Audit Logs</h1>
        <p class="text-muted mb-0">Latest 100 server-side audit entries. This page is read-only.</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">UserName</th>
                        <th scope="col">Role</th>
                        <th scope="col">Timestamp (UTC)</th>
                        <th scope="col">Email</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-muted">No audit logs are available yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.Id</td>
                                <td>@(string.IsNullOrWhiteSpace(log.UserName) ? "(unknown)" : log.UserName)</td>
                                <td>@(string.IsNullOrWhiteSpace(log.Role) ? "-" : log.Role)</td>
                                <td>@log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(string.IsNullOrWhiteSpace(log.Email) ? "-" : log.Email)</td>
                                <td>@log.Action</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
